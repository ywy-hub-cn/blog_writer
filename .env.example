# ============================================
# Blog-Writer AI 工作流系统 - 环境变量配置示例
# ============================================
# 使用方法:
#   1. 复制此文件为 .env:  copy .env.example .env
#   2. 根据部署环境修改变量值
#   3. 重启服务使环境变量生效（uvicorn --reload 不会重新加载 .env）
#
# 配置文件路径:
#   - 本文件: .env.example（模板，不提交实际密钥）
#   - 实际配置: .env（项目根目录，勿提交Git）
#   - 详细说明: docs/使用指南.md
# ============================================


# ============================================
# 1. 运行模式（必设）
# ============================================
# development | production
# production 模式下启用安全限制（严格CORS、生产日志等）
BLOG_WRITER_MODE=development

# 自定义配置文件路径（默认自动查找 blog_writer/config.json）
# BLOG_WRITER_CONFIG=./blog_writer/config.json


# ============================================
# 2. 管理员认证（必设）
# ============================================
# 管理员密码（bcrypt 哈希存储在 config.json；生产环境务必修改）
# 默认: admin123
BLOG_WRITER_ADMIN_PASSWORD=changeme

# 运营用户密码（用于免登录模式下的默认运营用户）
# 留空则使用管理员密码
BLOG_WRITER_OPERATOR_PASSWORD=

# API Token（用于 X-API-Key 请求头认证；留空则禁用 Token 认证）
BLOG_WRITER_API_TOKEN=

# JWT Token 过期时间（小时），默认 24
# 也可在 config.json 的 security.token_expire_hours 中设置
# BLOG_WRITER_TOKEN_EXPIRE_HOURS=24


# ============================================
# 3. 数据库配置（生产环境推荐 PostgreSQL）
# ============================================
# sqlite | postgres | mysql
# 默认 sqlite，零配置，数据库文件在 blog_writer/instance/blog_writer.db
DB_BACKEND=sqlite

# ---------- PostgreSQL（DB_BACKEND=postgres 时使用）----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_writer
DB_USER=blog_writer
DB_PASSWORD=

# ---------- MySQL（DB_BACKEND=mysql 时使用）----------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=blog_writer
# MYSQL_USER=blog_writer
# MYSQL_PASSWORD=


# ============================================
# 4. LLM 大模型配置（必设，AI 写作核心）
# ============================================
# LLM API Key（优先于 config.json 中的 llm.models.default.api_key）
# 支持 DeepSeek / OpenAI / 通义千问 / 智谱AI / Ollama 等兼容 OpenAI 协议的服务
LLM_API_KEY=

# LLM Base URL
# DeepSeek:  https://api.deepseek.com/v1
# OpenAI:    https://api.openai.com/v1
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱AI:    https://open.bigmodel.cn/api/paas/v4
# Ollama:    http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.deepseek.com/v1


# ============================================
# 5. 状态外置（可选，生产环境推荐 Redis）
# ============================================
# memory | redis
# 默认 memory（内存存储，重启丢失）；生产环境推荐 redis
BLOG_WRITER_STATE_BACKEND=memory

# Redis 连接 URL（BLOG_WRITER_STATE_BACKEND=redis 时必填）
# 格式: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# 审核事件总线后端: memory | redis
# 默认 memory（单进程内存事件，重启丢失）；多副本部署时必须设为 redis
# 设为 redis 时使用上面的 REDIS_URL
REVIEW_EVENT_BACKEND=memory


# ============================================
# 6. 工作流参数（可选）
# ============================================
# 单次任务最大 Tool 调用次数（防无限循环），默认 100，复杂任务建议 200
BLOG_WRITER_MAX_TOOL_CALLS=200

# 整任务超时秒数（0 表示不超时），默认 0
# 注意：单步超时由 config.json 的 workflow.step_timeout_minutes 控制
BLOG_WRITER_TASK_TIMEOUT_SECONDS=0

# 任务内存状态 TTL 秒（默认 300），仅 memory 后端有效
BLOG_WRITER_TASK_MEMORY_TTL_SECONDS=300

# 最大并发任务数（默认 3），超过此数的任务会排队等待
# 根据服务器性能和LLM API速率限制调整，建议 5
MAX_CONCURRENT_TASKS=5


# ============================================
# 7. CORS 跨域与安全
# ============================================
# 允许的跨域来源（逗号分隔；留空使用 config.json 中的默认值）
# 生产环境务必配置为实际域名，不要用通配符
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 公司域名（生产环境自动添加 https://app. / https://admin. / https://api. / https://ops. 子域）
COMPANY_DOMAIN=

# 受信任的代理地址（逗号分隔；Nginx 反向代理时需添加 Nginx IP）
TRUSTED_PROXIES=127.0.0.1,::1

# 响应字段命名风格: snake | camel
# Python 默认 snake_case；Java 后端对接务必设为 camel（Docker Compose 默认已是 camel）
RESPONSE_CASE=camel

# 定时任务调度扫描间隔（秒），默认 15；需进程 24×7 在线
# BLOG_WRITER_SCHEDULER_INTERVAL_SECONDS=15

# 任务 API 鉴权: required | optional（默认 optional，Web UI 可匿名使用）
# 仅 Java 服务间对接且需强制 Token 时设为 required
# BLOG_WRITER_TASK_AUTH=optional

# Java 服务间 Token（X-API-Key 请求头）
# BLOG_WRITER_API_TOKEN=your-service-token

# 健康检查 envelope: true 时 /health、/ready 也返回 {code,message,data}（Java 监控常用）
# BLOG_WRITER_HEALTH_ENVELOPE=true


# ============================================
# 8. SSO 单点登录（可选，企业部署时启用）
# ============================================
# 是否启用 SSO（详细配置在 config.json 的 security.sso 中）
SSO_ENABLED=false


# ============================================
# 9. 日志与通知（可选）
# ============================================
# 日志格式: text | json
LOG_FORMAT=text

# 日志 Webhook URL（错误日志推送到该地址；留空则禁用）
WEBHOOK_URL=

# 日志推送级别: DEBUG | INFO | WARNING | ERROR
WEBHOOK_LEVEL=ERROR


# ============================================
# 10. 沙箱环境变量（通常无需修改，由系统自动设置）
# ============================================
# 实例目录（Agent 沙箱执行时自动注入，无需手动设置）
# INSTANCE_DIR=

# 节点参数 JSON（Agent 沙箱执行时自动注入，无需手动设置）
# PARAMS_JSON={}
